{
  "name": "@billionsend/node",
  "version": "0.2.0",
  "description": "Node.js and TypeScript SDK for the BillionSend email API",
  "keywords": [
    "billionsend",
    "email",
    "api",
    "sdk",
    "inbox",
    "smtp",
    "transactional-email"
  ],
  "homepage": "https://billionsend.com/docs/sdks/node",
  "bugs": "https://github.com/billionsend/billionsend-node/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/billionsend/billionsend-node.git"
  },
  "license": "MIT",
  "author": "BillionSend",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:smoke": "node test/smoke/smoke.cjs && node test/smoke/smoke.mjs",
    "check:exports": "attw --pack . --profile node16",
    "generate": "openapi-typescript openapi/api.openapi.json --output src/generated/openapi.ts --root-types --root-types-no-schema-prefix --default-non-nullable false && biome format --write src/generated/openapi.ts",
    "openapi:sync": "node scripts/sync-openapi.mjs",
    "openapi:check": "node scripts/sync-openapi.mjs --check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "openapi-typescript": "7.13.0",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
